<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Restore both entries if the app starts using RECEIVER_NOT_EXPORTED. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".DenaroApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Denaro">
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Denaro.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.QuickEntryWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_quick_entry_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_entry_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickTransactionWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_quick_transaction_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_transaction_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickDebtWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_quick_debt_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_debt_info" />
        </receiver>
    </application>

</manifest>
